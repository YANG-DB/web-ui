RETURN p, r0, p1"
`;

exports[`every template linkedin #9: Multi-relationship LinkedIn query (advanced) 1`] = `
"MATCH (p:Person)-[r0:WorksAt]->(c:Company), (p:Person)-[r1:ConnectedTo]->(p1:Person)
